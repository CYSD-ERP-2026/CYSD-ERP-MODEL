# DJANGO_DEBUG: Set to True for development, False for production
DJANGO_DEBUG=False

# DJANGO_SECRET_KEY: Secret key for cryptographic signing
DJANGO_SECRET_KEY=django-insecure-replace-with-a-long-random-string-in-production

# DJANGO_ALLOW_INSECURE_DEFAULT_SECRET: Set to True if you want to bypass the strong secret key check
DJANGO_ALLOW_INSECURE_DEFAULT_SECRET=False

# DJANGO_ALLOWED_HOSTS: Comma-separated list of allowed hostnames/IPs
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# DJANGO_CSRF_TRUSTED_ORIGINS: Comma-separated list of trusted origins for CSRF (e.g. https://yourdomain.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# DATABASE_URL: URL to connect to the database (e.g. postgres://user:pass@host:port/dbname)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cysd_erp_db

# DJANGO_CACHE_URL: URL for caching backend (e.g. redis://127.0.0.1:6379/1)
DJANGO_CACHE_URL=locmemcache://cysd-erp-dashboard

# DJANGO_SECURE_SSL_REDIRECT: Set to True to redirect all HTTP traffic to HTTPS (production)
DJANGO_SECURE_SSL_REDIRECT=False

# DJANGO_SECURE_HSTS_SECONDS: Time in seconds for Strict-Transport-Security (HSTS)
DJANGO_SECURE_HSTS_SECONDS=31536000

# DJANGO_SESSION_COOKIE_SECURE: Set to True to only send session cookies over HTTPS
DJANGO_SESSION_COOKIE_SECURE=False

# DJANGO_CSRF_COOKIE_SECURE: Set to True to only send CSRF cookies over HTTPS
DJANGO_CSRF_COOKIE_SECURE=False
